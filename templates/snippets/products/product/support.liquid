{%- if product.support_content != blank %}
  {%- capture content %}
    <div class="sc-rich-text">
      <div>{{ product.support_content }}</div>
    </div>
  {%- endcapture %}

  {%- capture icon %}
    {%- render "shared/icons/headset", style_class: "sc-icon-no-fill", width: 20 %}
  {%- endcapture %}

  {% render "shared/accordion", heading: product.support_label, content: content, icon: icon %}
{%- endif %}
