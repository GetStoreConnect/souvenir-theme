{%- if product.warranty_content != blank %}
  {%- capture content %}
    <div class="sc-rich-text">
      <div>{{ product.warranty_content }}</div>
    </div>
  {%- endcapture %}
  
  {%- capture icon %}
    {%- render "shared/icons/shield", style_class: "sc-icon-no-fill", width: 20 %}
  {%- endcapture %}

  {% render "shared/accordion", heading: product.warranty_label, content: content, icon: icon %}
{%- endif %}
