{%- assign top_left_side_active = theme_variables["top.menu.left_side_message_display"] | default: true -%}

<div class="sc-header_top_inner sc-flex sc-justify-center-up-to-large sc-ps-small sc-lg:ps-large sc-ms-auto sc-pe-tiny">
  {% comment %} left side {% endcomment %}
  <div class="sc-one-half-medium-and-up sc-flex sc-align-items-center sc-gap-medium">   
    {% comment %} Actionable message - left side {% endcomment %}
    {%- unless top_left_side_active == false %}
      <div class="sc-flex sc-justify-center sc-font-micro sc-font-bold">
        {{ "top.menu.actionable_message" | t }}
      </div>
    {%- endunless %}
  </div>

  {% comment %} right side {% endcomment %}
  <div class="sc-one-half-medium-and-up sc-flex sc-justify-end sc-hide-up-to-medium">
    {% comment %} account {% endcomment %}
    <div class="sc-flex sc-justify-center sc-gap-medium sc-ps-medium">
      {%- if current_customer == blank %}
        <a href="{{ current_store.login_path }}" class="sc-font-micro sc-font-bold sc-flex sc-align-items-center sc-gap-tiny">
          {%- render 'shared/icons/user', width: '20', style_class: 'sc-mb-micro sc-icon-no-fill' %}
          <span class="sc-hide">{{ "header.dropdowns.account.login" | t }}</span>
        </a>
      {%- else %}
        <a href="{{ current_store.account_path }}" class="sc-font-micro sc-font-bold sc-flex sc-align-items-center sc-gap-tiny">
          {%- render 'shared/icons/circle_user_round', width: '20', style_class: 'sc-mb-micro sc-icon-no-fill' %}
        </a>
      {%- endif %}
    </div>

   {% comment %} Support {% endcomment %}
    <div class="sc-flex sc-justify-center sc-align-items-center sc-gap-medium sc-pl-medium">
      {% comment %} Target {% endcomment %}
      <div class="sc-font-micro sc-font-bold">
        {{ "top.menu.support_label" | t }}
      </div>
    </div>
  </div>
</div>